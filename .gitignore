# generated bundles (build-wsl.sh regenerates them from web/ and assets/cheats)
ps5-app/onconsole/web_bundle.h
ps4-app/onconsole/web_bundle.h
# PS4 dashboard app: everything the toolchain regenerates. The .pkg itself IS tracked - the exe
# bundles it, so a fresh clone must be able to build the companion without the PS4 toolchain.
ps4-app/tile-pkg/pms/x64/
ps4-app/tile-pkg/eboot.bin
ps4-app/tile-pkg/pkg.gp4
ps4-app/tile-pkg/pms-payload.elf
ps4-app/onconsole/PKG-MUTANT-SHOP-PS4-LITE.elf
ps4-app/tile-pkg/sce_sys/param.sfo
ps4-app/tile-pkg/sce_sys/about/
ps4-app/tile-pkg/sce_module/
# the PS4 test fixtures are generated by tools/ps4-itest/make_fixtures.py
tools/ps4-itest/app.db
tools/ps4-itest/addcont.db
ps5-app/onconsole/cheat_bundle.h
ps5-app/onconsole/cheats.pack

# PyInstaller outputs when run from the repo root
/dist/
/build/
